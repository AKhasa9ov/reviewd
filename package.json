{
  "name": "dsh-code-review-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKhasa9ov/reviewd.git"
  },
  "homepage": "https://github.com/AKhasa9ov/reviewd#readme",
  "bugs": {
    "url": "https://github.com/AKhasa9ov/reviewd/issues"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "fat:verify": "node scripts/verify-fat-package.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm build && pnpm docs:check && pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build:web": "vite build --config packages/web/vite.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:a11y": "pnpm build && playwright test --grep @a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
