{
  "name": "@dsh-code-review/dsh",
  "version": "0.1.0",
  "description": "Code review panel, tools, reviewer worker and feedback delivery for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "web",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-code-review/dsh-code-review.git"
  },
  "homepage": "https://github.com/dsh-code-review/dsh-code-review#readme",
  "bugs": {
    "url": "https://github.com/dsh-code-review/dsh-code-review/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
