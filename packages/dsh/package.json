{
  "name": "@sir_yami/reviewd",
  "version": "0.2.0",
  "description": "Code review panel, review daemon, tools, reviewer worker and feedback delivery for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "code-review",
    "review"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "web",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jsdom": "30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKhasa9ov/reviewd.git",
    "directory": "packages/dsh"
  },
  "homepage": "https://github.com/AKhasa9ov/reviewd#readme",
  "bugs": {
    "url": "https://github.com/AKhasa9ov/reviewd/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
