# Copy this file to .env and replace the token. Never commit .env.
#
# Generate a token with:
#   openssl rand -hex 32
CODE_REVIEW_TOKEN=

# Host loopback port mapped to reviewd's container port 3100.
CODE_REVIEW_PORT=3100

# The exact origin users open in a browser. Use https:// behind a TLS proxy.
CODE_REVIEW_PUBLIC_URL=http://127.0.0.1:3100

# Optional image tag/version label.
# CODE_REVIEW_IMAGE=dsh-code-review:local
# CODE_REVIEW_VERSION=0.1.0

# Optional: mount a repository tree at the SAME absolute path inside the container.
# The daemon and the DSH worker must agree on that path. Use docker-compose.repo.yml
# for this; see docs/ops.md.
# CODE_REVIEW_REPOS=/absolute/path/to/repos
